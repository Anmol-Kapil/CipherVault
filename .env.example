# New uploads go to your own Google Drive. Use local only for an offline demo/test.
CIPHERVAULT_STORAGE=drive

# Paths are relative to the repository root unless absolute.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Optional: an existing folder accessible to this OAuth app.
# Leave blank to create/reuse the app's CipherVault folder automatically.
GOOGLE_FOLDER_ID=

# SQLite metadata and the persistent encryption key stay on your computer.
CIPHERVAULT_DATA_DIR=.local-data
